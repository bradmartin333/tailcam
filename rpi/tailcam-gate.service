# Starts and stops tailcam.service to follow the door sensor; see the README ("Door sensor"). Install it
# with rpi/install.sh. To change the settings below, use
# `sudo systemctl edit tailcam-gate.service`, which keeps them when install.sh is rerun.
[Unit]
Description=Run tailcam only while the door sensor's circuit is closed
# Give up after 3 failed starts in a minute (e.g. a TAILCAM_GATE_PIN with no such GPIO) instead of
# restarting forever. systemctl status then shows it failed, and the journal says why.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Environment=TAILCAM_GATE_PIN=17
Environment=TAILCAM_GATE_SETTLE=2
# install.sh copies gate.py here, root-owned. -I keeps Python from importing anything from elsewhere.
ExecStart=python3 -I /usr/local/lib/tailcam/gate.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

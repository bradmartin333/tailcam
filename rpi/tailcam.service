# Runs tailcam from this checkout; see the README ("Door sensor"). Install it with rpi/install.sh,
# which fills in the @...@ values.
[Unit]
Description=tailcam webcam server

[Service]
# idle waits for the rest of boot, which gives the USB webcams time to show up: tailcam looks for
# cameras only once, at startup. No After=multi-user.target, which would be an ordering cycle with
# WantedBy= below.
Type=idle
ExecStart=/bin/sh "@DIR@/run.sh"
WorkingDirectory=@DIR@
User=@USER@
# To open the cameras and their mics, even if @USER@ isn't in these groups.
SupplementaryGroups=video audio
# systemd's PATH leaves out ~/.local/bin, where uv's installer puts it.
Environment="UV=@UV@"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
